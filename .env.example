# CentrAlign AI Environment Configuration Example
ENVIRONMENT=development

# LLM Providers
# 1. Local Ollama (Primary: private & fast local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# 2. Google Gemini API (Cloud Fallback for full autonomous reasoning)
GEMINI_API_KEY=

# 3. OpenAI / Compatible API (Alternative Cloud Fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Internal Target Ledger App
TARGET_APP_URL=http://127.0.0.1:8000
DB_VAULT_PATH=company_vault.db

# Autonomous Browser Configuration
BROWSER_HEADLESS=false
MAX_STEP_CAP=10
TRANSIENT_RETRY_LIMIT=3
INITIAL_BACKOFF_DELAY_SECS=1.0
